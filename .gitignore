# Repo-wide ignores. The Flutter app has its own list in app/.gitignore, and the
# Obsidian vault has one in "Purnara Brain/.gitignore".

# Secrets never enter the repo. API keys live only on the server.
.env
.env.*
!.env.example
*.pem
*.key

# graphify working files and cache (the graph outputs themselves are kept)
**/graphify-out/.graphify_*
**/graphify-out/cache/

# Python (backend/, evals/)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
htmlcov/

# Local data: the SQLite database and uploaded documents (backend/data by default).
backend/data/

# Editors and OS. The shared VS Code setup (run/debug, tasks, extensions) is kept.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
