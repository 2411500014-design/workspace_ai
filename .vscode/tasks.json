{
  // Terminal > Run Task... Every task runs from the right folder.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: install dependencies (uv sync)",
      "type": "shell",
      "command": "uv sync",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Backend: run API (port 8000)",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Backend: tests",
      "type": "shell",
      "command": "uv run pytest",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Backend: lint (ruff)",
      "type": "shell",
      "command": "uv run ruff check .",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "App: get packages",
      "type": "shell",
      "command": "flutter pub get",
      "options": { "cwd": "${workspaceFolder}/app" },
      "problemMatcher": []
    },
    {
      "label": "App: generate translations (gen-l10n)",
      "type": "shell",
      "command": "flutter gen-l10n",
      "options": { "cwd": "${workspaceFolder}/app" },
      "problemMatcher": []
    },
    {
      "label": "App: analyze",
      "type": "shell",
      "command": "flutter analyze",
      "options": { "cwd": "${workspaceFolder}/app" },
      "problemMatcher": []
    },
    {
      "label": "App: tests",
      "type": "shell",
      "command": "flutter test",
      "options": { "cwd": "${workspaceFolder}/app" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "App: build web (served by the backend on port 8000)",
      "type": "shell",
      "command": "flutter build web --release",
      "options": { "cwd": "${workspaceFolder}/app" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "App: build Android APK",
      "type": "shell",
      "command": "flutter build apk --release",
      "options": { "cwd": "${workspaceFolder}/app" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "App: build Windows",
      "type": "shell",
      "command": "flutter build windows --release",
      "options": { "cwd": "${workspaceFolder}/app" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Check everything (backend + app)",
      "dependsOrder": "sequence",
      "dependsOn": ["Backend: lint (ruff)", "Backend: tests", "App: analyze", "App: tests"],
      "problemMatcher": []
    }
  ]
}
